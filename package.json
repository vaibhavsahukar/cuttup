{
  "name": "cut-up",
  "productName": "CUT-UP",
  "version": "1.0.0",
  "description": "Infinitely generated arcade traffic game",
  "author": "CUT-UP",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis portable --x64",
    "tune": "tsx scripts/tune.ts",
    "smoke": "tsx scripts/smoke.ts",
    "check:traffic": "tsx scripts/traffic-check.ts",
    "check:features": "tsx scripts/features-check.ts",
    "dist:dir": "npm run build && electron-builder --win dir --x64",
    "artifact": "npm run build && node scripts/make-artifact.mjs"
  },
  "build": {
    "appId": "com.cutup.game",
    "productName": "CUT-UP",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "CUT-UP-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "draco3dgltf": "^1.5.7",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wait-on": "^9.4.0"
  }
}